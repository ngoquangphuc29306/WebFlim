# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Public PHEVO site URL used by metadata, sitemap, robots, and canonical URL helpers.
# Set this to the real production URL before deploying. Defaults to localhost in development.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server-only TMDB Read Access Token for future metadata enrichment.
# Do not use a NEXT_PUBLIC_ variable and do not commit a real token.
TMDB_API_READ_ACCESS_TOKEN=

# Optional server-side metadata locale. Defaults to vi-VN when omitted.
TMDB_LANGUAGE=vi-VN

# SUPABASE CONFIGURATION:
# Public Supabase URL and Anon Key for client-side authentication and cloud sync.
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
